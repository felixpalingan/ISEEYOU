# ==============================================================================
# ISEEYOU Environment Configuration Template
# Copy this file to .env.local (for frontend) and .env (for docker/backend)
# ==============================================================================

# ------------------------------------------------------------------------------
# App & Gateway (Next.js 15)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# OSINT Worker Engine (Python FastAPI)
# ------------------------------------------------------------------------------
WORKER_PORT=8000
WORKER_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Redis Cache & Task Broker
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Optional Cloud Database & Auth (Supabase)
# Leave blank to use local SQLite/in-memory session for quick scans
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# Optional External API Tokens (Higher Rate Limits)
# Not required for MVP — Zero-cost public endpoints are enabled by default
# ------------------------------------------------------------------------------
GITHUB_TOKEN=your_github_personal_access_token_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here
GEMINI_API_KEY=your_google_ai_studio_gemini_key_here
